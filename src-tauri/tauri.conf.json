{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zebra-agent-ui",
  "version": "0.1.1",
  "identifier": "com.zebraagent.ui",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Zebra Agent Manager",
        "width": 900,
        "height": 620,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
